# Local development database (docker compose exposes Postgres on host port 5433)
DATABASE_URL=postgresql://torob:torob_local_dev@localhost:5433/torob

# LLM (BoxAPI, OpenAI-compatible). Server-side only — never expose to the browser.
# Verified base URL and model-ID format (see DECISIONS.md D-020).
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_MODEL_HARD=openai/gpt-6-sol
LLM_INPUT_PRICE_PER_MILLION=0.12
LLM_OUTPUT_PRICE_PER_MILLION=0.58
LLM_BUDGET_USD=3
EMBEDDING_MODEL=text-embedding-3-small

APP_BASE_URL=http://localhost:3000
# Simulated seller answers (55% in stock, 25% out of stock, 20% no answer).
DEMO_MODE=true
SEED_ON_START=true

# Real dataset import (shops.csv, products.csv, offers.csv).
# DATA_DIR is used first; IMPORT_URL may point to a base URL or a .zip archive.
DATA_DIR=
IMPORT_URL=

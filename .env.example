# Local development database (docker compose exposes Postgres on host port 5433)
DATABASE_URL=postgresql://torob:torob_local_dev@localhost:5433/torob

# LLM (BoxAPI, OpenAI-compatible). Server-side only — never expose to the browser.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_MODEL_HARD=gpt-6-sol
EMBEDDING_MODEL=text-embedding-3-small

APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

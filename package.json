{
  "name": "torob-in-store-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/llm-smoke-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts --reset",
    "db:seed:if-empty": "node --env-file-if-exists=.env --import tsx src/db/seed.ts --if-empty",
    "db:report": "node --env-file-if-exists=.env --import tsx src/db/report.ts",
    "db:import": "npm run import --",
    "build:db": "esbuild src/db/seed.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/seed.mjs --external:pg --external:pg-native",
    "agent:smoke": "node --env-file-if-exists=.env --import tsx scripts/agent-smoke.ts",
    "agent:run-smoke": "node --env-file-if-exists=.env --import tsx scripts/agent-run-smoke.ts",
    "data:profile": "node --env-file-if-exists=.env --import tsx scripts/profile-dataset.ts",
    "import": "node scripts/run-import.mjs",
    "build:import": "esbuild scripts/import-dataset.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/import.mjs --external:pg --external:pg-native",
    "data:quality": "node --env-file-if-exists=.env --import tsx scripts/data-quality-report.ts",
    "data:addresses": "node --env-file-if-exists=.env --import tsx scripts/backfill-addresses.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.75",
    "ai": "^7.0.148",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
